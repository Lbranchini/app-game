# Copy to .env and edit as needed.
#   cp .env.example .env
# Defaults are wired so `docker compose up` works out of the box with SQLite.

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate a real secret for non-dev use, e.g.:  openssl rand -hex 32
JWT_SIGNING_SECRET=dev-only-change-me
JWT_AUDIENCE=agora-clients
JWT_ISSUER=agora-server
JWT_ACCESS_TTL_SECONDS=900

# ─── CORS / origin where the web client lives ──────────────────────────────
WEB_ORIGIN=http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────
# Default = SQLite at /app/state/agora.db inside the server container,
# persisted via the `server-state` named volume.
DATABASE_URL=sqlite:////app/state/agora.db
# To switch to the postgres profile (`docker compose --profile postgres up`),
# uncomment and use:
# DATABASE_URL=postgresql+psycopg://agora:agora@postgres:5432/agora
# POSTGRES_USER=agora
# POSTGRES_PASSWORD=agora
# POSTGRES_DB=agora

# ─── OAuth (optional — leave blank to use only the dev-token endpoint) ─────
# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Apple (Apple's .p8 private key contents go inline)
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_REDIRECT_URI=http://localhost:8000/auth/apple/callback
